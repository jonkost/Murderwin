# Copy to scripts/.env (gitignored). NEVER commit the real values.
# Anthropic API key for sealed-content generation.
ANTHROPIC_API_KEY=
# Path to a Firebase service-account key JSON (also gitignored).
# Console → Project settings → Service accounts → Generate new private key,
# save as scripts/service-account.json.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
