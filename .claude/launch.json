{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "murderwin",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "workshop",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
