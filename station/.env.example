# The study station (the M1 MacBook Air). Copy to station/.env and fill in.
# Never committed: .env is in .gitignore.

# The Elements wall (white hexagons, touch). Reserve its address on the router.
NANOLEAF_ELEMENTS_HOST=192.168.1.50
NANOLEAF_ELEMENTS_TOKEN=

# The Lines wall (colour bars, no touch). Separate controller, separate token.
NANOLEAF_LINES_HOST=192.168.1.51
NANOLEAF_LINES_TOKEN=

# The key the host typed on the Host tab under "The study". Same text here.
STATION_KEY=

# Pairing a token, once per controller: hold the controller's power button
# 5–7 seconds until the LED flashes, then within 30 seconds run
#   curl -X POST http://<host>:16021/api/v1/new
# and paste the auth_token above.
