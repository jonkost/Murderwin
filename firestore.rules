rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // A phone whose session is marked host (the guest-list lines
    // "— host: Jonathan" / "— host: Susan"). Runs the night without Google.
    function isHost() {
      return signedIn()
        && exists(/databases/$(database)/documents/sessions/$(request.auth.uid))
        && get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.host != null;
    }

    // ---- STAFF: Jon + Jenna, the Steward (workshop access) ----
    // Jon by UID. Jenna by the SHA-256 of their verified Google email — the repo
    // is public, so the address itself never appears here. Staff reach the
    // workshop only: nothing here opens sealed/* or cases/*.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid in ['JYSmPSQfdMen0leIDYmqUa32Prt1'] ||
        (request.auth.token.email_verified == true &&
          hashing.sha256(request.auth.token.email.lower()).toHexString().lower() in [
            '2ea18fbeb53147b23ca3afa1e1291934aeea1b6e5c6c2c7b40b6301386ffe2b8' // Jenna (Steward), added 28 Sep 2026
          ])
      );
    }

    // ---- THE SEAL: no client ever reads sealed content or raw cases ----
    match /sealed/{doc=**} {
      allow read, write: if false;   // Admin SDK (Cloud Functions) only
    }
    match /cases/{doc=**} {
      allow read, write: if false;   // Admin SDK only
    }

    // ---- WORKSHOP (safe layers): admin read/create/update. NOTHING is ever
    // hard-deleted — deletes are soft flags, enforced here, not by discipline.
    match /safe_content/{doc=**}     { allow read, create, update: if isAdmin(); allow delete: if false; }
    match /workshop_history/{doc=**} { allow read, create: if isAdmin(); allow update, delete: if false; }
    match /tasks/{doc=**}            { allow read, create, update: if isAdmin(); allow delete: if false; }
    match /decisions/{doc=**}        { allow read, create, update: if isAdmin(); allow delete: if false; }
    match /meta/{doc=**}             { allow read, create, update: if isAdmin(); allow delete: if false; }

    // ---- Aggregates only: safe for admin dashboard ----
    match /validation_reports/{doc=**} { allow read: if isAdmin(); allow write: if false; }

    // ---- PLAYER SURFACES (game night) ----
    // Phones sign in anonymously. Everything a phone reads is either public
    // night state (same for everyone) or its own session doc, which Cloud
    // Functions write. A phone never reads anyone else's session, and never
    // touches sealed/* or cases/*. Added 8 Oct 2026 with the play client.

    // Which night is live right now.
    match /public_state/{doc=**} {
      allow read: if signedIn();
      allow write: if false;         // Functions only
    }

    // The night: act, phase, guest list, who plays whom (identities are public).
    match /nights/{nightId} {
      allow read: if signedIn();
      allow write: if false;         // Functions only
      // Safe content copied for the phones: rules, bios, NPC cards, UI lines.
      match /public/{doc=**} {
        allow read: if signedIn();
        allow write: if false;
      }
      // The draw order and which phone holds which guest. Nobody reads this.
      match /private/{doc=**} {
        allow read, write: if false;
      }
    }

    // One doc per phone: your character, bag number, affection, and later your
    // role and everything dealt to you. Only that phone can read it.
    match /sessions/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;         // Functions only
    }

    // Heartbeat from each phone (online dots on the Host tab, clock skew).
    match /presence/{uid} {
      allow read: if isAdmin() || isHost() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nightId', 'guestKey', 'at']);
      allow delete: if false;
    }

    // A player's own scribbles: crossed-off motives, prompts already hidden.
    // Nothing in here is dealt by the game, so the phone may write it.
    match /notes/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
