# The cue relay (the game-server Mac). Copy to cues/.env and fill in.
# Never committed: .env is in .gitignore.

# The Hue bridge. Reserve its address on the router.
HUE_BRIDGE_HOST=192.168.1.40
# The application key the bridge gave you (press the bridge button, then
#   curl -k -X POST https://<bridge>/api -d '{"devicetype":"murderwin#brain","generateclientkey":true}'
# and copy "username" from the answer).
HUE_APP_KEY=
# The id of the bulb outside the bedroom. `npm start -- --lights` lists them.
HUE_HALL_LIGHT_ID=

# Where the sound files live. Each file is named after its event id: 7F3A.m4a
MEDIA_DIR=../media
