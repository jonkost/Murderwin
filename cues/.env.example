# The cue relay (the game-server Mac). Copy to cues/.env and fill in.
# Never committed: .env is in .gitignore.

# The Hue bridge. Reserve its address on the router.
HUE_BRIDGE_HOST=192.168.1.40
# The application key the bridge gave you (press the bridge button, then
#   curl -k -X POST https://<bridge>/api -d '{"devicetype":"murderwin#brain","generateclientkey":true}'
# and copy "username" from the answer).
HUE_APP_KEY=
# The id of the bulb outside the bedroom. `npm start -- --lights` lists them.
HUE_HALL_LIGHT_ID=

# Where the sound files live. Each file is named after its event id: 7F3A.m4a
MEDIA_DIR=../media

# The study station key, the same one the host saves for the station
# (Host tab, station-key). On a night with a key saved, the W-O-O-F News
# recordings reach this relay as codes; with this set it maps each code back
# to its file. Leave it empty for a rehearsal with no key saved.
STATION_KEY=

# ---- Music, Hue scenes and the Orangerie string lights (24 Oct) ----
# Apple Music on this Mac plays the three Murderwin playlists, as cues/scenes.json
# says. MUSIC=off leaves the music to you and the Music app.
MUSIC=on
# The four Murderwin scenes, recalled by name on the same Hue bridge as the hall
# light (cues/scenes.json). HUE_SCENES=off leaves them to the Hue app on your phone.
HUE_SCENES=on
# The Orangerie string lights (Nanoleaf Holiday String Lights), red and green in
# Salem's game. Reserve their address on the router. Pair once: hold the button
# on the strings' controller 5 to 7 seconds until the lights flash, then within
# 30 seconds
#   curl -X POST http://<address>:16021/api/v1/new
# and copy "auth_token" from the answer. Leave both empty and the phones carry
# the colour on their own.
NANOLEAF_STRINGS_HOST=
NANOLEAF_STRINGS_TOKEN=
# Or, with no pairing: through Apple Home. Make three Home scenes for the
# Holiday Lights (red full, green full, a soft warm glow) and three Shortcuts
# that run them, named exactly
#   Red Murderwin Strings · Green Murderwin Strings · Decor Murderwin Strings
# and set this to on. Leave the two
# lines above empty. Apple Home takes about a second, so the phones lead.
STRINGS_SHORTCUTS=
